#!/bin/sh

IFNAME=$1
CMD=$2

/usr/bin/logger "wpa_action $IFNAME $CMD"

if [ "$CMD" = "CONNECTED" ]; then
	# Kick DHCP client to do a renewal
	if [ -r /var/run/udhcpc.$IFNAME.pid ]; then
		kill -usr1 `cat /var/run/udhcpc.$IFNAME.pid`
	fi
fi

# Nothing to do on DISCONNECTED: wpa_supplicant reconnects by itself (and on
# the Radio, /usr/sbin/wifi-watchdog recovers links that do not come back).

